# Node 24+ · copy to .env. Never commit .env or real credentials.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/blorp.sqlite
UPLOADS_PATH=data/uploads
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Set only when behind exactly this many trusted reverse-proxy hops.
TRUST_PROXY_HOPS=0

# AI: OpenAI-compatible chat/completions streaming API. Server only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Supply a real model ID available to your provider account. No invented defaults.
AI_DEFAULT_MODEL=
AI_MODEL_FAST=
AI_MODEL_CORE=
AI_MODEL_REASON=
AI_MODEL_CODE=
AI_MODEL_VISION=
AI_MODEL_RESEARCH=
AI_MODEL_CREATIVE=
AI_MODEL_MAX=

# SMTP email delivery. TLS is required; certificate validation stays enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Google OAuth callback: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin credentials. Generate a scrypt hash with npm run admin:hash.
ADMIN_ID=
ADMIN_PASSWORD_HASH=
ADMIN_OTP_EMAIL=

# Open checkout only after testing AI, SMTP and admin sign-in.
# AI + configured admin email/password are also required server-side.
PAYMENTS_ENABLED=false
